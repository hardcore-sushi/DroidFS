<resources>
    <style name="BaseTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@drawable/window_background</item>
        <item name="windowBackgroundColor">@color/backgroundColor</item>
        <item name="android:textColorHighlight">@color/text_color_highlight</item>
        <item name="colorPrimary">@color/green</item>
        <item name="colorOnPrimary">#a0000000</item>
        <item name="colorButtonForeground">@color/buttonForeground</item>
        <item name="menuIconColor">@color/white</item>
        <item name="colorPrimaryContainer">@color/green</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <item name="colorSecondary">@color/green</item>
        <item name="colorSurface">@color/darkGrey</item>
        <item name="colorSurfaceContainer">@color/darkGrey</item>
        <item name="textColorSecondary">@color/textColorSecondary</item>
        <item name="infoBarBackgroundColor">#181818</item>
        <item name="materialAlertDialogTheme">@style/DarkGreenDialog</item>
        <item name="preferenceTheme">@style/MultilinePreference</item>
    </style>

    <style name="DarkRed" parent="BaseTheme">
        <item name="colorPrimary">@color/red</item>
        <item name="colorPrimaryContainer">@color/red</item>
        <item name="colorSecondary">@color/red</item>
        <item name="materialAlertDialogTheme">@style/DarkRedDialog</item>
    </style>
    <style name="DarkBlue" parent="BaseTheme">
        <item name="colorPrimary">@color/blue</item>
        <item name="colorPrimaryContainer">@color/blue</item>
        <item name="colorSecondary">@color/blue</item>
        <item name="materialAlertDialogTheme">@style/DarkBlueDialog</item>
    </style>
    <style name="DarkYellow" parent="BaseTheme">
        <item name="colorPrimary">@color/yellow</item>
        <item name="colorPrimaryContainer">@color/yellow</item>
        <item name="colorSecondary">@color/yellow</item>
        <item name="materialAlertDialogTheme">@style/DarkYellowDialog</item>
    </style>
    <style name="DarkOrange" parent="BaseTheme">
        <item name="colorPrimary">@color/orange</item>
        <item name="colorPrimaryContainer">@color/orange</item>
        <item name="colorSecondary">@color/orange</item>
        <item name="materialAlertDialogTheme">@style/DarkOrangeDialog</item>
    </style>
    <style name="DarkPurple" parent="BaseTheme">
        <item name="colorPrimary">@color/purple</item>
        <item name="colorPrimaryContainer">@color/purple</item>
        <item name="colorSecondary">@color/purple</item>
        <item name="materialAlertDialogTheme">@style/DarkPurpleDialog</item>
    </style>
    <style name="DarkPink" parent="BaseTheme">
        <item name="colorPrimary">@color/pink</item>
        <item name="colorPrimaryContainer">@color/pink</item>
        <item name="colorSecondary">@color/pink</item>
        <item name="materialAlertDialogTheme">@style/DarkPinkDialog</item>
    </style>

    <style name="BlackGreen" parent="BaseTheme">
        <item name="windowBackgroundColor">@color/black</item>
        <item name="infoBarBackgroundColor">@color/black</item>
        <item name="materialAlertDialogTheme">@style/BlackGreenDialog</item>
    </style>
    <style name="BlackRed" parent="BlackGreen">
        <item name="colorPrimary">@color/red</item>
        <item name="colorPrimaryContainer">@color/red</item>
        <item name="colorSecondary">@color/red</item>
        <item name="materialAlertDialogTheme">@style/BlackRedDialog</item>
    </style>
    <style name="BlackBlue" parent="BlackGreen">
        <item name="colorPrimary">@color/blue</item>
        <item name="colorPrimaryContainer">@color/blue</item>
        <item name="colorSecondary">@color/blue</item>
        <item name="materialAlertDialogTheme">@style/BlackBlueDialog</item>
    </style>
    <style name="BlackYellow" parent="BlackGreen">
        <item name="colorPrimary">@color/yellow</item>
        <item name="colorPrimaryContainer">@color/yellow</item>
        <item name="colorSecondary">@color/yellow</item>
        <item name="materialAlertDialogTheme">@style/BlackYellowDialog</item>
    </style>
    <style name="BlackOrange" parent="BlackGreen">
        <item name="colorPrimary">@color/orange</item>
        <item name="colorPrimaryContainer">@color/orange</item>
        <item name="colorSecondary">@color/orange</item>
        <item name="materialAlertDialogTheme">@style/BlackOrangeDialog</item>
    </style>
    <style name="BlackPurple" parent="BlackGreen">
        <item name="colorPrimary">@color/purple</item>
        <item name="colorPrimaryContainer">@color/purple</item>
        <item name="colorSecondary">@color/purple</item>
        <item name="materialAlertDialogTheme">@style/BlackPurpleDialog</item>
    </style>
    <style name="BlackPink" parent="BlackGreen">
        <item name="colorPrimary">@color/pink</item>
        <item name="colorPrimaryContainer">@color/pink</item>
        <item name="colorSecondary">@color/pink</item>
        <item name="materialAlertDialogTheme">@style/BlackPinkDialog</item>
    </style>

    <style name="DynamicColor" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/window_background</item>
        <item name="windowBackgroundColor">?attr/colorSurface</item>
        <item name="android:textColorHighlight">@color/text_color_highlight</item>
        <item name="colorSecondary">?attr/colorPrimary</item>
        <item name="colorButtonForeground">?attr/colorOnPrimary</item>
        <item name="textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="menuIconColor">?attr/colorOnSurfaceVariant</item>
        <item name="infoBarBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Material3.MaterialAlertDialog</item>
        <item name="preferenceTheme">@style/MultilinePreference</item>
    </style>

    <style name="MultilinePreference" parent="PreferenceThemeOverlay">
        <item name="singleLineTitle">false</item>
    </style>

    <style name="Button" parent="Widget.Material3.Button">
        <item name="android:textColor">?attr/colorButtonForeground</item>
        <item name="iconTint">?attr/colorButtonForeground</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:drawablePadding">5dp</item>
    </style>

    <style name="ActionButton" parent="Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginTop">@dimen/volume_operation_vertical_gap</item>
        <item name="android:paddingStart">60dp</item>
        <item name="android:paddingEnd">60dp</item>
    </style>

    <style name="PasswordInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_marginTop">@dimen/password_input_margin_top</item>
    </style>

    <style name="infoBarTextView">
        <item name="android:ellipsize">start</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
