<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fullScreenBackgroundColor">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <sushi.hardcore.droidfs.vlc.LibVlcPlayerView
            android:id="@+id/video_player"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <sushi.hardcore.droidfs.widgets.DoubleTapOverlay
            android:id="@+id/double_tap_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible"/>

        <LinearLayout
            android:id="@+id/gesture_feedback"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/video_gesture_feedback_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/image_gesture_feedback"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                app:tint="@color/neutralIconTint" />

            <ProgressBar
                android:id="@+id/progress_gesture_feedback"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:indeterminate="false"
                android:max="100"
                android:progressBackgroundTint="#55FFFFFF"
                android:progressTint="@color/secondary" />

            <TextView
                android:id="@+id/text_gesture_feedback"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:gravity="end"
                android:textColor="@color/textColor"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/scrub_feedback"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/video_gesture_feedback_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/text_scrub_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/textColor"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_scrub_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/textColorSecondary"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/progress_scrub_feedback"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"
                android:indeterminate="false"
                android:max="1000"
                android:progressBackgroundTint="#55FFFFFF"
                android:progressTint="@color/secondary" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/video_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#B0000000"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/button_play_pause"
                    style="@style/ExoMediaButton"
                    android:contentDescription="@string/play_pause"
                    android:src="@drawable/icon_pause"
                    app:tint="@color/neutralIconTint" />

                <TextView
                    android:id="@+id/text_position"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="0:00"
                    android:textColor="@color/textColor"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seek_bar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="1000" />

                <TextView
                    android:id="@+id/text_duration"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="0:00"
                    android:textColor="@color/textColor"
                    android:textSize="12sp" />

            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/button_repeat_mode"
                        style="@style/ExoMediaButton"
                        android:contentDescription="@string/repeat_mode"
                        android:src="@drawable/icon_repeat"
                        app:tint="@color/neutralIconTint" />

                    <ImageButton
                        android:id="@+id/button_scaling_mode"
                        style="@style/ExoMediaButton"
                        android:contentDescription="@string/scaling_mode"
                        android:src="@drawable/icon_aspect_ratio"
                        app:tint="@color/neutralIconTint" />

                    <ImageButton
                        android:id="@+id/button_orientation_lock"
                        style="@style/ExoMediaButton"
                        android:contentDescription="@string/orientation_lock"
                        android:src="@drawable/icon_lock_open"
                        app:tint="@color/neutralIconTint" />

                    <TextView
                        android:id="@+id/button_ab_start"
                        android:layout_width="42dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center"
                        android:text="@string/ab_repeat_start_short"
                        android:textColor="@color/textColor"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/button_ab_end"
                        android:layout_width="42dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center"
                        android:text="@string/ab_repeat_end_short"
                        android:textColor="@color/textColor"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/button_ab_clear"
                        android:layout_width="42dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center"
                        android:text="@string/clear"
                        android:textColor="@color/textColorSecondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/text_ab_range"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:minWidth="130dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:singleLine="true"
                        android:textColor="@color/textColorSecondary"
                        android:textSize="12sp" />

                </LinearLayout>

            </HorizontalScrollView>

        </LinearLayout>

    </FrameLayout>

    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="20dp">

        <TextView
            android:id="@+id/text_file_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="@dimen/title_file_name_text_size"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/rotate_button"
            android:layout_centerVertical="true"/>

        <ImageButton
            android:id="@+id/rotate_button"
            style="@style/ExoMediaButton"
            android:src="@drawable/icon_screen_rotation"
            app:tint="@color/neutralIconTint"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"/>

    </RelativeLayout>

</RelativeLayout>
